{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "A33_ADC_NOISE_DIAG_MODE": "0"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "A33_ADC_NOISE_DIAG_MODE": "0"
            }
        },
        {
            "name": "BoardDiagnostics",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "A33_ENABLE_BOARD_DIAGNOSTICS": "ON",
                "A33_ADC_NOISE_DIAG_MODE": "0"
            }
        },
        {
            "name": "AdcDiagInternalShort",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "A33_ADC_NOISE_DIAG_MODE": "1"
            }
        },
        {
            "name": "AdcDiagChannelA",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "A33_ADC_NOISE_DIAG_MODE": "2"
            }
        },
        {
            "name": "AdcDiagChannelA_DisplayOff",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "A33_ADC_NOISE_DIAG_MODE": "3"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "BoardDiagnostics",
            "configurePreset": "BoardDiagnostics"
        },
        {
            "name": "AdcDiagInternalShort",
            "configurePreset": "AdcDiagInternalShort"
        },
        {
            "name": "AdcDiagChannelA",
            "configurePreset": "AdcDiagChannelA"
        },
        {
            "name": "AdcDiagChannelA_DisplayOff",
            "configurePreset": "AdcDiagChannelA_DisplayOff"
        }
    ]
}
