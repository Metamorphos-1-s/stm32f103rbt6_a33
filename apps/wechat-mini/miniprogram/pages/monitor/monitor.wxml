<view class="page"><view class="weight-band {{stale ? 'stale' : ''}}"><view class="status-row"><text>{{state}}</text><text>{{stable ? '稳定' : '不稳定'}}</text></view><view class="weight"><text>{{weight}}</text><text class="unit">{{unit}}</text></view><view wx:if="{{stale}}" class="stale-label">数据陈旧</view></view><view class="metrics"><view><text class="muted">NET</text><text class="value">{{net}}</text></view><view><text class="muted">GROSS</text><text class="value">{{gross}}</text></view><view><text class="muted">TARE</text><text class="value">{{tare}}</text></view></view><view class="panel"><view class="section-title">重量状态</view><view class="grid"><text>显示锁定</text><text>{{locked ? '是' : '否'}}</text><text>过载</text><text class="{{overload ? 'error' : ''}}">{{overload ? '是' : '否'}}</text><text>检重</text><text>{{check}}</text><text>灯状态</text><text>{{lamps}}</text></view></view><view class="panel"><view class="section-title">测量与诊断</view><view class="grid"><text>Raw</text><text>{{raw}}</text><text>Filtered</text><text>{{filtered}}</text><text>Runtime Drift</text><text>{{drift}}</text><text>配置未保存</text><text>{{dirty ? '是' : '否'}}</text><text>Fault Mask</text><text>{{fault}}</text></view></view><view class="panel"><view class="section-title">数据年龄</view><view class="grid"><text>FAST</text><text>{{fastAge}}</text><text>SLOW</text><text>{{slowAge}}</text><text>CHECK</text><text>{{checkAge}}</text></view></view><button class="secondary" bindtap="refreshConfig" disabled="{{state !== 'READY' && state !== 'DEGRADED'}}">刷新设备信息与活动配置</button></view>
