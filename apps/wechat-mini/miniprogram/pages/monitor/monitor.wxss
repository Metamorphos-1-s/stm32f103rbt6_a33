.weight-band{background:#182026;color:#fff;padding:28rpx;border-radius:12rpx;margin-bottom:20rpx}.weight-band.stale{background:#6b4d20}.status-row{display:flex;justify-content:space-between;font-size:24rpx;color:#d9e1e4}.weight{font-size:88rpx;font-weight:600;line-height:1.4;letter-spacing:0}.unit{font-size:32rpx;margin-left:14rpx}.stale-label{color:#ffd48a}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-bottom:20rpx}.metrics>view{background:#fff;border:1rpx solid #dce2e5;padding:18rpx 12rpx}.metrics text{display:block}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx 24rpx}.value{font-size:26rpx}
.refresh-status{text-align:center;color:#68767e;font-size:24rpx;margin-top:12rpx}
