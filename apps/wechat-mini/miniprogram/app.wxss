page{background:#f3f5f6;color:#182026;font-family:system-ui,sans-serif}.page{padding:28rpx}.panel{background:#fff;border:1rpx solid #dce2e5;border-radius:12rpx;padding:24rpx;margin-bottom:20rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.muted{color:#68767e}.error{color:#b42318}.ok{color:#087f5b}.warning{color:#a15c00}.button-row{display:flex;gap:16rpx;margin:20rpx 0}.button-row button{flex:1;margin:0;font-size:28rpx}.primary{background:#087f5b!important;color:#fff!important}.secondary{background:#fff!important;color:#26343c!important;border:1rpx solid #aeb9bf}.danger{background:#fff!important;color:#b42318!important;border:1rpx solid #e3aaa5}.section-title{font-size:26rpx;font-weight:600;color:#45545c;margin-bottom:14rpx}.value{font-variant-numeric:tabular-nums}.tag{padding:4rpx 12rpx;border-radius:6rpx;background:#edf1f2;font-size:24rpx}
